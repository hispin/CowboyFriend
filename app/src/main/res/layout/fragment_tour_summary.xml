<?xml version="1.0" encoding="utf-8"?>
<!-- Tour summary screen (shown when a tour ends) in the Wild West style: a brown header with the title, the date and the
     duration, a scrolling body with the coverage, the four number tiles, what needs attention and the comparison with the
     previous tour, and two buttons that stay at the bottom (share, close). see fragment_tour_summary in layout-land for landscape -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    android:orientation="vertical">

    <!-- header: flag, title, the date and the duration; X closes the screen -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ww_saddle_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tour_flag"
            android:tint="@color/ww_brass_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heebo_extrabold"
                android:text="@string/summary_title"
                android:textColor="@color/ww_parchment"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/tvSummarySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heebo_medium"
                android:textColor="@color/ww_brass_light"
                android:textSize="13sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/ibSummaryClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_ww_photo_ring"
            android:contentDescription="@string/close"
            android:elevation="6dp"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_large_close_badge" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <include layout="@layout/view_summary_coverage" />

            <include
                layout="@layout/view_summary_tiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                layout="@layout/view_summary_attention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <!-- the buttons stay at the bottom: share the summary (brass), close -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnSummaryShare"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape_ww_btn_rect_brass"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:text="@string/summary_share"
            android:textColor="@color/ww_iron"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnSummaryClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:paddingStart="26dp"
            android:paddingTop="12dp"
            android:paddingEnd="26dp"
            android:paddingBottom="12dp"
            android:text="@string/close"
            android:textColor="@color/ww_ink"
            android:textSize="18sp" />
    </LinearLayout>
</LinearLayout>

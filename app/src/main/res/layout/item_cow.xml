<?xml version="1.0" encoding="utf-8"?>
<!-- One cow card of the cattle tour list (VIEW mode only, Wild West style): photo, big number, type and status chips with colors / icons.
     nothing is edited here: the pencil badge (or a tap on the card) opens the edit window. llContainer is the card itself, vSeenStrip is its colored top band. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/llContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="14dp"
    android:layout_marginTop="7dp"
    android:layout_marginEnd="14dp"
    android:layout_marginBottom="7dp"
    android:background="@drawable/shape_ww_card_bg"
    android:clipToOutline="true"
    android:elevation="5dp"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical">

    <!-- top band: turquoise = seen today, brass = not seen today, iron = corpse (colored by the adapter) -->
    <View
        android:id="@+id/vSeenStrip"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:background="@color/ww_brass" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <!-- header: round photo (tap = large picture), the big cow number with the cow type under it, and the edit badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCowImg"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:background="@drawable/shape_ww_photo_ring"
                android:contentDescription="@string/cow_details"
                android:elevation="3dp"
                android:padding="3dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- the cow number and, next to it, the last two digits of the birth year (hidden when the birth date is unknown) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:baselineAligned="true"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvCowNum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/rye_regular"
                        android:textColor="@color/ww_ink"
                        android:textDirection="ltr"
                        android:textSize="26sp"
                        tools:text="№ 123" />

                    <!-- birth year (two digits): same Rye font, smaller and lighter, so it reads as a tag of the number -->
                    <TextView
                        android:id="@+id/tvCowYear"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="@font/rye_regular"
                        android:textColor="@color/ww_saddle"
                        android:textDirection="ltr"
                        android:textSize="20sp"
                        tools:text="25" />
                </LinearLayout>

                <!-- cow type as plain text under the number (it is changed in the edit window) -->
                <TextView
                    android:id="@+id/tvCowType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/heebo_bold"
                    android:textColor="@color/ww_saddle_dark"
                    android:textSize="16sp"
                    tools:text="עגל" />
            </LinearLayout>

            <!-- edit badge: opens the edit window of this cow -->
            <ImageView
                android:id="@+id/ivEditCow"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:contentDescription="@string/edit_cow_title"
                android:elevation="4dp"
                android:src="@drawable/ic_edit_badge" />
        </LinearLayout>

        <!-- all the chips in one wrapping flow: a chip without a value is gone and the others close the gap -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvGender"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_info_bg"
                tools:text="נקבה" />

            <TextView
                android:id="@+id/tvMonNum"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_info_bg"
                android:drawableStart="@drawable/ic_chip_cow"
                tools:text="אמא 84" />

            <!-- seen today (green, check) / not seen today (amber, warning triangle) -->
            <TextView
                android:id="@+id/tvLastSeen"
                style="@style/Ww.StatusChip"
                tools:text="לא נצפתה מאז 14/09" />

            <!-- calves only: with the mother (green) / without the mother (red) -->
            <TextView
                android:id="@+id/tvWithMomStatus"
                style="@style/Ww.StatusChip"
                android:drawableStart="@drawable/ic_chip_cow"
                tools:text="עם אימו" />

            <!-- calves only: ear tag (green) / no ear tag (red) -->
            <TextView
                android:id="@+id/tvEarTagStatus"
                style="@style/Ww.StatusChip"
                android:drawableStart="@drawable/ic_chip_tag"
                tools:text="תג אוזן" />

            <!-- corpse stamp: dark plate with a cow skull, the card gets an iron top band -->
            <TextView
                android:id="@+id/tvCorpseStamp"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_dead_bg"
                android:drawableStart="@drawable/ic_chip_skull"
                android:drawableTint="@color/ww_brass_light"
                android:text="@string/corpse"
                android:textColor="@color/ww_brass_light" />

            <TextView
                android:id="@+id/tvLastDateLocation"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_info_bg"
                android:drawableStart="@drawable/ic_chip_pin"
                tools:text="21/07/26" />

            <!-- comment: "has a comment" (tap = the window with the comment, read aloud) / "no comment" (faded) -->
            <TextView
                android:id="@+id/tvComment"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_info_bg"
                android:drawableStart="@drawable/ic_chip_note"
                tools:text="יש הערה" />

            <!-- health problems (rust): the name of the problem, or the number of problems; tap = the list of them.
                 hidden when the cow has no problem -->
            <TextView
                android:id="@+id/tvHealth"
                style="@style/Ww.StatusChip"
                android:background="@drawable/shape_ww_chip_bad_bg"
                android:drawableStart="@drawable/ic_chip_health"
                android:visibility="gone"
                tools:text="עטין נפוח" />

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="tvGender,tvMonNum,tvLastSeen,tvHealth,tvWithMomStatus,tvEarTagStatus,tvCorpseStamp,tvLastDateLocation,tvComment"
                app:flow_horizontalAlign="start"
                app:flow_horizontalBias="0"
                app:flow_horizontalGap="8dp"
                app:flow_horizontalStyle="packed"
                app:flow_verticalGap="8dp"
                app:flow_wrapMode="chain"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Cattle tour screen: parchment background, a top bar with the cows counter and the filter chips, the cow cards list and a brass refresh button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    tools:context=".UI.CattleTourFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar: the counter of the cows shown right now and the voice search button (say a cow number) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCowsCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_chip_bg"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:textColor="@color/ww_ink"
                android:textSize="18sp"
                tools:text="מוצגות 12 מתוך 40" />

            <!-- small "?" between the counter and the microphone: opens the guide of the voice search -->
            <TextView
                android:id="@+id/btnSearchGuide"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_ww_photo_ring"
                android:contentDescription="@string/search_guide_button"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:text="?"
                android:textColor="@color/ww_brass_light"
                android:textSize="18sp"
                tools:ignore="HardcodedText" />

            <!-- voice search: the app asks for a cow number and shows only the cows with that number -->
            <ImageView
                android:id="@+id/ivVoiceSearch"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/voice_search_cow"
                android:elevation="8dp"
                android:src="@drawable/ic_mic_badge" />
        </LinearLayout>

        <!-- filter chips, one selected at a time; tapping the selected chip again shows all the cows -->
        <HorizontalScrollView
            android:id="@+id/hsvFilters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">


                <!-- shown only during a voice search: the searched number, tap to cancel the search -->
                <TextView
                    android:id="@+id/chipSearch"
                    style="@style/Ww.FilterChip"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/chipFilterAll"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_all" />

                <!-- the cows that need attention (see CowIssues); the number of them is added to the text by the code -->
                <TextView
                    android:id="@+id/chipFilterAttention"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_attention" />

                <TextView
                    android:id="@+id/chipFilterCalves"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_calves" />

                <TextView
                    android:id="@+id/chipFilterCalvesNotSeen"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_calves_not_seen" />

                <TextView
                    android:id="@+id/chipFilterBulls"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_bulls" />

                <!-- only the cows that have a health problem -->
                <TextView
                    android:id="@+id/chipFilterHealth"
                    style="@style/Ww.FilterChip"
                    android:text="@string/filter_health" />
            </LinearLayout>
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- bottom padding keeps the last card above the refresh button; clipToPadding off so cards scroll through it -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcShowCows"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="2dp"
                android:paddingBottom="110dp"
                tools:listitem="@layout/item_cow" />

            <!-- shown instead of the list when the selected filter matches no cow -->
            <TextView
                android:id="@+id/tvEmptyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:padding="32dp"
                android:text="@string/no_cows_match_filter"
                android:textColor="@color/ww_ink_soft"
                android:textSize="20sp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- the tour pill, above the refresh button: just a flag when there is no tour, turquoise with the progress ("12/18")
         while a tour is open. a tap opens the tour window (start / end the tour, the history) -->
    <LinearLayout
        android:id="@+id/llTourPill"
        android:layout_width="wrap_content"
        android:layout_height="56dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:background="@drawable/shape_ww_tour_pill_idle"
        android:contentDescription="@string/tour_dialog_title"
        android:elevation="8dp"
        android:gravity="center"
        android:minWidth="56dp"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <ImageView
            android:id="@+id/ivTourPill"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tour_flag"
            android:tint="@color/ww_iron" />

        <TextView
            android:id="@+id/tvTourPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="@font/heebo_extrabold"
            android:textColor="@color/ww_parchment"
            android:textDirection="ltr"
            android:textSize="17sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- refresh the list: brass round button with a dark icon and border -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbRefreshCows"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/refresh_cows"
        android:src="@drawable/refresh"
        android:visibility="visible"
        app:backgroundTint="@color/ww_brass"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:rippleColor="#55FFFFFF"
        app:tint="@color/ww_iron" />

    <!-- fixed loading overlay shown while an edited cow is being saved (same as on the new cow screen): blocks touches meanwhile -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990F0905"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_ww_voice_card"
            android:elevation="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="30dp"
            android:paddingEnd="40dp"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/ivLoadingSpinner"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/avd_ww_loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/heebo_bold"
                android:text="@string/saving_cow"
                android:textColor="@color/ww_ink"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- fixed result message after the save (same plaque as on the new cow screen): success / failure -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_ww_result_banner"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/heebo_bold"
            android:textColor="@color/ww_parchment"
            android:textSize="17sp" />
    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Map screen (Mapbox): the map in a warm dusk light, a counter of the cows on the map, the locate button in brass,
     and a small parchment plate with the spinning horseshoe while the current location is loading -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:mapbox="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    tools:context="UI.MapmobFragment">

    <com.mapbox.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        mapbox:mapbox_cameraBearing="-17.6"
        mapbox:mapbox_cameraTargetLat="32.941484"
        mapbox:mapbox_cameraTargetLng="35.795603"
        mapbox:mapbox_cameraZoom="16" />

    <!-- layer over the map that holds the popup of a cow; the fragment places the popup above its pin (inside the screen) -->
    <FrameLayout
        android:id="@+id/flPopupLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- how many cows are shown on the map (text is set by the fragment) -->
    <TextView
        android:id="@+id/tvMapCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="14dp"
        android:background="@drawable/shape_ww_chip_ok_bg"
        android:drawableStart="@drawable/ic_chip_pin"
        android:drawablePadding="6dp"
        android:drawableTint="@color/ww_ink"
        android:elevation="6dp"
        android:fontFamily="@font/heebo_extrabold"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:textColor="@color/ww_ink"
        android:textSize="16sp"
        android:visibility="gone"
        tools:text="12 פרות במפה"
        tools:visibility="visible" />

    <!-- the current location is loading: a plate with the spinning horseshoe and the message; the map stays usable -->
    <LinearLayout
        android:id="@+id/llLoadLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="22dp"
        android:paddingTop="16dp"
        android:paddingEnd="26dp"
        android:paddingBottom="16dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivLoadLocation"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:contentDescription="@null"
            android:src="@drawable/avd_ww_loading" />

        <TextView
            android:id="@+id/tvLoadLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:fontFamily="@font/heebo_extrabold"
            android:text="@string/load_my_location"
            android:textColor="@color/ww_ink"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- result message of adding / removing an element (same plaque as the other screens): success / failure -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_ww_result_banner"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/heebo_bold"
            android:textColor="@color/ww_parchment"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- heat map button: off / all the cows / only the cows that need attention; brass when off, rust while it is on -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbHeat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="188dp"
        android:contentDescription="@string/map_heat_toggle"
        android:src="@drawable/ic_map_heat"
        app:backgroundTint="@color/ww_brass"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:rippleColor="#55FFFFFF"
        app:tint="@null" />

    <!-- map type toggle: normal map / satellite; brass for the normal map, turquoise while the satellite is shown -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbMapType"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="108dp"
        android:contentDescription="@string/map_type_toggle"
        android:src="@drawable/ic_map_layers"
        app:backgroundTint="@color/ww_brass"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:rippleColor="#55FFFFFF"
        app:tint="@null" />

    <!-- locate me: a brass button with a dark crosshair; the map moves to the cowboy on the horse -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fbRefresh1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:contentDescription="@string/map_locate_me"
        android:src="@drawable/ic_locate_me"
        android:visibility="visible"
        app:backgroundTint="@color/ww_brass"
        app:borderWidth="0dp"
        app:elevation="8dp"
        app:rippleColor="#55FFFFFF"
        app:tint="@null" />

</FrameLayout>

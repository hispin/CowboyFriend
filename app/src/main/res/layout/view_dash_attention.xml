<?xml version="1.0" encoding="utf-8"?>
<!-- Ranch dashboard block: what needs attention (a row for every problem) and the button that shows those cows.
     included by fragment_ranch_dashboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_ww_dialog_row_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/heebo_bold"
        android:text="@string/summary_attention"
        android:textColor="@color/ww_ink"
        android:textSize="15sp" />

    <LinearLayout
        android:id="@+id/llDashAttention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvDashAllGood"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:fontFamily="@font/heebo_bold"
        android:text="@string/summary_all_good"
        android:textColor="@color/ww_turquoise_dark"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/btnDashShowAttention"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/shape_ww_btn_rect_sand"
        android:elevation="3dp"
        android:fontFamily="@font/heebo_bold"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:text="@string/summary_show_attention"
        android:textColor="@color/ww_ink"
        android:textSize="15sp" />
</LinearLayout>

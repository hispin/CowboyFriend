<?xml version="1.0" encoding="utf-8"?>
<!-- Login screen in the Wild West style of the new cow screen: parchment, desert banner, card with the fields, brass login button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment">

    <!-- scrolls when the keyboard is open or the screen is small -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- desert banner with the horseshoe coin overlapping its bottom edge -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="104dp"
                    android:background="@drawable/shape_ww_banner_sky">

                    <!-- banner height is close to the artwork ratio, so fitXY keeps the sun almost round and shows the whole scene -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@null"
                        android:scaleType="fitXY"
                        android:src="@drawable/ic_scene_banner" />
                </FrameLayout>

                <ImageView
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="-30dp"
                    android:contentDescription="@null"
                    android:elevation="10dp"
                    android:src="@drawable/ic_horseshoe_badge" />
            </FrameLayout>

            <!-- ranch name, same label as on the new cow screen -->
            <TextView
                android:id="@+id/tvFarmName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:alpha="0.75"
                android:fontFamily="@font/rye_regular"
                android:gravity="center"
                android:letterSpacing="0.08"
                android:text="RANCH №7"
                android:textColor="@color/ww_saddle_dark"
                android:textDirection="ltr"
                android:textSize="14sp"
                tools:ignore="HardcodedText" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:text="@string/welcome"
                android:textColor="@color/ww_ink"
                android:textSize="30sp" />

            <!-- card holding the user name and password fields -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="24dp"
                android:background="@drawable/shape_ww_voice_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="24dp"
                android:paddingEnd="24dp"
                android:paddingBottom="28dp">

                <TextView
                    android:id="@+id/tvUser"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/user"
                    style="@style/Ww.Title" />

                <androidx.appcompat.widget.AppCompatEditText
                    android:id="@+id/etUsername"
                    android:imeOptions="flagNoExtractUi"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/shape_ww_edittext_bg"
                    android:inputType="textEmailAddress"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:singleLine="true"
                    android:textDirection="ltr"
                    android:textSize="17sp"
                    style="@style/Ww.EditText" />

                <!-- validation message of the user name field (hidden until the field fails validation) -->
                <TextView
                    android:id="@+id/tvUserError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/heebo_bold"
                    android:textColor="@color/ww_rust_dark"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/tvPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/password"
                    style="@style/Ww.Title" />

                <!-- password field with the show / hide eye on top of its end side -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp">

                    <!-- paddingEnd leaves room for the eye so the text never runs under it -->
                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etPassword"
                        android:imeOptions="flagNoExtractUi"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/shape_ww_edittext_bg"
                        android:inputType="textPassword"
                        android:paddingStart="14dp"
                        android:paddingEnd="56dp"
                        android:singleLine="true"
                        android:textDirection="ltr"
                        android:textSize="17sp"
                        style="@style/Ww.EditText" />

                    <!-- eye toggle: closed eye while the password is hidden, open eye while it is shown (swapped in LoginFragment) -->
                    <ImageView
                        android:id="@+id/ivTogglePassword"
                        android:layout_width="48dp"
                        android:layout_height="56dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/show_password"
                        android:focusable="true"
                        android:padding="10dp"
                        android:src="@drawable/ic_eye_closed" />
                </FrameLayout>

                <!-- validation message of the password field (hidden until the field fails validation) -->
                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="@font/heebo_bold"
                    android:textColor="@color/ww_rust_dark"
                    android:textSize="14sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- login button: ivLogin is the clickable pill, tvConnection its label (raised above it) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="28dp"
                android:layout_marginEnd="24dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/ivLogin"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/shape_ww_login_btn"
                    android:clickable="true"
                    android:contentDescription="@string/connect"
                    android:elevation="8dp"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/tvConnection"
                    android:layout_width="wrap_content"
                    android:layout_height="60dp"
                    android:layout_gravity="center"
                    android:elevation="10dp"
                    android:fontFamily="@font/heebo_extrabold"
                    android:gravity="center"
                    android:text="@string/connect"
                    android:textColor="@color/ww_iron"
                    android:textSize="22sp" />
            </FrameLayout>
        </LinearLayout>
    </ScrollView>

    <!-- loading while logging in: the spinning horseshoe of the saving overlay, centered and above everything -->
    <ProgressBar
        android:id="@+id/pbLogin"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:elevation="20dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/avd_ww_loading"
        android:visibility="gone" />

    <!-- fixed result message at the bottom (same plaque as on the new cow screen): login success / failure -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_ww_result_banner"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/heebo_bold"
            android:textColor="@color/ww_parchment"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>

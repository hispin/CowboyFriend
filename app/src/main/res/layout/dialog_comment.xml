<?xml version="1.0" encoding="utf-8"?>
<!-- Comment window of a cow (cattle tour), VIEW only: the comment is shown big and read aloud; the speaker badge reads it again.
     the comment is edited in the edit window of the cow, not here -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <!-- title with the cow number -->
        <TextView
            android:id="@+id/tvCommentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:textColor="@color/ww_ink"
            android:textSize="22sp" />

        <!-- the speaker badge (right side, first) reads the comment again, then the comment text -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivCommentSpeak"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/shape_ww_photo_ring"
                android:contentDescription="@string/comment_read_again"
                android:elevation="6dp"
                android:padding="14dp"
                android:src="@drawable/ic_chip_speaker"
                android:tint="@color/ww_brass_light" />

            <ScrollView
                android:id="@+id/svComment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_dialog_row_bg"
                android:fadeScrollbars="false">

                <TextView
                    android:id="@+id/tvCommentText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/heebo_medium"
                    android:lineSpacingExtra="6dp"
                    android:padding="16dp"
                    android:textColor="@color/ww_ink"
                    android:textIsSelectable="true"
                    android:textSize="20sp" />
            </ScrollView>
        </LinearLayout>

        <!-- close; closing also stops the reading aloud -->
        <TextView
            android:id="@+id/btnCommentClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:paddingStart="36dp"
            android:paddingTop="10dp"
            android:paddingEnd="36dp"
            android:paddingBottom="10dp"
            android:text="@string/close"
            android:textColor="@color/ww_ink"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>

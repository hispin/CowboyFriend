<?xml version="1.0" encoding="utf-8"?>
<!-- Ranch dashboard block: the trend of the tour coverage (the last tours). included by fragment_ranch_dashboard -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/shape_ww_dialog_row_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/heebo_bold"
        android:text="@string/dash_trend"
        android:textColor="@color/ww_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvDashTrendText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/heebo_medium"
        android:textColor="@color/ww_ink_soft"
        android:textSize="13sp" />

    <com.israel.cowboyfriend.UI.widget.TrendBarsView
        android:id="@+id/trendBars"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvDashTrendEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/heebo_medium"
        android:text="@string/dash_trend_empty"
        android:textColor="@color/ww_ink_soft"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- A question window in the style of the app (used to end a tour): a title, a message, a brass confirm button and a sand
     button to go back. the texts are set by the code that opens it -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <TextView
            android:id="@+id/tvConfirmTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:textColor="@color/ww_ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tvConfirmMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/heebo_medium"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ww_ink"
            android:textSize="18sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnConfirmYes"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_btn_rect_brass"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:textColor="@color/ww_iron"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnConfirmNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="22dp"
                android:paddingTop="11dp"
                android:paddingEnd="22dp"
                android:paddingBottom="11dp"
                android:textColor="@color/ww_ink"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

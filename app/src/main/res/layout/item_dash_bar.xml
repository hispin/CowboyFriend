<?xml version="1.0" encoding="utf-8"?>
<!-- One row of a list with bars on the ranch dashboard (health problems, years of birth): a label, a bar whose filled part
     has the weight of its share (set in code), and the value at the end -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="9dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tvBarLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.25"
        android:fontFamily="@font/heebo_medium"
        android:textColor="@color/ww_ink"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/llBarTrack"
        android:layout_width="0dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:background="@drawable/shape_ww_edittext_bg"
        android:orientation="horizontal"
        android:padding="2dp"
        android:weightSum="100">

        <View
            android:id="@+id/vBarFill"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@color/ww_rust" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvBarValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:fontFamily="@font/heebo_extrabold"
        android:minWidth="30dp"
        android:gravity="end"
        android:textColor="@color/ww_ink"
        android:textDirection="ltr"
        android:textSize="14sp" />
</LinearLayout>

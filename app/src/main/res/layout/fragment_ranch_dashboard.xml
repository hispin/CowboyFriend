<?xml version="1.0" encoding="utf-8"?>
<!-- Ranch dashboard (portrait): a brown header with the title, and a scrolling column of cards: the herd, what needs
     attention, the health problems, births and deaths by year, the trend of the tours and the heat map; the share buttons
     (text, PDF) stay at the bottom. llDashContent is also what is drawn into the PDF. see layout-land for landscape -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ww_saddle_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tour_flag"
            android:tint="@color/ww_brass_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:fontFamily="@font/heebo_extrabold"
            android:text="@string/dash_title"
            android:textColor="@color/ww_parchment"
            android:textSize="21sp" />

        <ImageButton
            android:id="@+id/ibDashClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/shape_ww_photo_ring"
            android:contentDescription="@string/close"
            android:elevation="6dp"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_large_close_badge" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:paddingTop="12dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:id="@+id/llDashContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ww_parchment"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <include layout="@layout/view_dash_herd" />

            <include
                layout="@layout/view_dash_attention"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                layout="@layout/view_dash_health"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                layout="@layout/view_dash_years"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                layout="@layout/view_dash_trend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />

            <include
                layout="@layout/view_dash_map"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/btnDashShareText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/shape_ww_btn_rect_brass"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/dash_share_text"
            android:textColor="@color/ww_iron"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/btnDashSharePdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="@string/dash_share_pdf"
            android:textColor="@color/ww_ink"
            android:textSize="17sp" />
    </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Health problems window of a cow (cattle tour), VIEW only: the problems of the cow as rust chips. "Edit" opens the edit
     window of the cow, where the problems are changed -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <!-- title with the cow number -->
        <TextView
            android:id="@+id/tvHealthTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:textColor="@color/ww_ink"
            android:textSize="22sp" />

        <!-- the problems, as chips that wrap -->
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/cgHealthList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnHealthEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_btn_rect_brass"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:text="@string/health_edit"
                android:textColor="@color/ww_iron"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnHealthClose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingTop="10dp"
                android:paddingEnd="28dp"
                android:paddingBottom="10dp"
                android:text="@string/close"
                android:textColor="@color/ww_ink"
                android:textSize="18sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

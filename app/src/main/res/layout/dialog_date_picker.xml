<?xml version="1.0" encoding="utf-8"?>
<!-- Date window of the new cow screen (birth date): the parchment card of the other windows, a spinner date picker in the app colors,
     and three buttons: choose (brass), today (sand) and cancel (sand) -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="26dp"
        android:paddingEnd="22dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:text="@string/date_dialog_title"
            android:textColor="@color/ww_ink"
            android:textSize="22sp" />

        <!-- the three wheels (day, month, year) on a sand plate; the colors come from the Ww.DatePickerTheme -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/shape_ww_dialog_row_bg"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <DatePicker
                android:id="@+id/datePicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:calendarViewShown="false"
                android:datePickerMode="spinner"
                android:spinnersShown="true"
                android:theme="@style/Ww.DatePickerTheme" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnDateOk"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_btn_rect_brass"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_extrabold"
                android:gravity="center"
                android:paddingTop="11dp"
                android:paddingBottom="11dp"
                android:text="@string/date_dialog_ok"
                android:textColor="@color/ww_iron"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/btnDateToday"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingTop="11dp"
                android:paddingEnd="18dp"
                android:paddingBottom="11dp"
                android:text="@string/date_dialog_today"
                android:textColor="@color/ww_ink"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/btnDateCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:elevation="4dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingTop="11dp"
                android:paddingEnd="18dp"
                android:paddingBottom="11dp"
                android:text="@string/voice_cancel"
                android:textColor="@color/ww_ink"
                android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

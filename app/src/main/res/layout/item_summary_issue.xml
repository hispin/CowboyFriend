<?xml version="1.0" encoding="utf-8"?>
<!-- One row of "needs attention" in the tour summary: a rust icon, the name of the problem and the number of cows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/ivIssueIcon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:contentDescription="@null"
        android:tint="@color/ww_rust_dark" />

    <TextView
        android:id="@+id/tvIssueLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:fontFamily="@font/heebo_medium"
        android:textColor="@color/ww_ink"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/tvIssueCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_health_chip_selected"
        android:fontFamily="@font/heebo_extrabold"
        android:minWidth="34dp"
        android:gravity="center"
        android:paddingStart="10dp"
        android:paddingTop="2dp"
        android:paddingEnd="10dp"
        android:paddingBottom="2dp"
        android:textColor="@color/ww_parchment"
        android:textSize="15sp" />
</LinearLayout>

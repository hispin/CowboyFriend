<?xml version="1.0" encoding="utf-8"?>
<!-- Window that opens after a long press on the map: the list of elements that can be added at that place (only the gate
     for now; each new element type is one more row like llAddGate) and a cancel button -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:text="@string/map_add_title"
            android:textColor="@color/ww_ink"
            android:textSize="22sp" />

        <!-- the gate row: the icon first (right side in Hebrew), then the name -->
        <LinearLayout
            android:id="@+id/llAddGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_ww_dialog_row_bg"
            android:foreground="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_map_gate" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/heebo_bold"
                android:text="@string/map_element_gate"
                android:textColor="@color/ww_ink"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnAddCancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:paddingStart="36dp"
            android:paddingTop="10dp"
            android:paddingEnd="36dp"
            android:paddingBottom="10dp"
            android:text="@string/voice_cancel"
            android:textColor="@color/ww_ink"
            android:textSize="18sp" />
    </LinearLayout>
</FrameLayout>

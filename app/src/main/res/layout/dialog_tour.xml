<?xml version="1.0" encoding="utf-8"?>
<!-- Tour window of the cattle tour screen: the state of the tour (no tour, or the progress of the open tour), the main
     button (start / end the tour) and the tour history. the texts of the state are set by the code that opens it.
     see layout-land/dialog_tour.xml for landscape -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_ww_dialog_card_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="20dp">

        <!-- title: the flag and "Tour" -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tour_flag"
                android:tint="@color/ww_saddle_dark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:fontFamily="@font/heebo_extrabold"
                android:text="@string/tour_dialog_title"
                android:textColor="@color/ww_ink"
                android:textSize="22sp" />
        </LinearLayout>

        <!-- the state: the headline, a line under it, and (in an open tour) the progress bar -->
        <TextView
            android:id="@+id/tvTourDialogHeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:textColor="@color/ww_ink"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvTourDialogInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/heebo_medium"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/ww_ink_soft"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/llTourDialogTrack"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/shape_ww_edittext_bg"
            android:orientation="horizontal"
            android:padding="2dp"
            android:visibility="gone"
            android:weightSum="100">

            <View
                android:id="@+id/vTourDialogFill"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/ww_turquoise" />
        </LinearLayout>

        <!-- the main button: start (brass) or end (sand with rust text) -->
        <TextView
            android:id="@+id/btnTourDialogMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/shape_ww_btn_rect_brass"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:textColor="@color/ww_iron"
            android:textSize="19sp" />

        <!-- the quiet row: the tour history, and closing the window -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnTourDialogHistory"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_tour_history"
                android:drawableTint="@color/ww_ink"
                android:elevation="3dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="@string/tour_history_short"
                android:textColor="@color/ww_ink"
                android:textSize="16sp" />

            <!-- the ranch dashboard: the numbers of the whole herd -->
            <TextView
                android:id="@+id/btnTourDialogDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/shape_ww_btn_rect_sand"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_tour_flag"
                android:drawableTint="@color/ww_ink"
                android:elevation="3dp"
                android:fontFamily="@font/heebo_bold"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingTop="10dp"
                android:paddingEnd="12dp"
                android:paddingBottom="10dp"
                android:text="@string/dash_title"
                android:textColor="@color/ww_ink"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnTourDialogClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="3dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:text="@string/close"
            android:textColor="@color/ww_ink"
            android:textSize="16sp" />
    </LinearLayout>
</FrameLayout>

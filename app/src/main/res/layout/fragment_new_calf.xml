<?xml version="1.0" encoding="utf-8"?>
<!-- Root FrameLayout: the form (ScrollView) plus two fixed overlays (loading and result) that stay in place while scrolling -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<!-- The form; fillViewport so the parchment background always fills the screen -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:clipToPadding="false">

<!-- 16dp side padding for the whole form; clipping disabled so shadows are not cut at the padding edge -->
<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="24dp"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    >

    <!-- Full-bleed desert banner at the top (negative side margins cancel the screen padding) -->
    <FrameLayout
        android:id="@+id/sceneBanner"
        android:layout_width="0dp"
        android:layout_height="96dp"
        android:layout_marginStart="-16dp"
        android:layout_marginEnd="-16dp"
        android:background="@drawable/shape_ww_banner_sky"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:src="@drawable/ic_scene_banner"
            android:contentDescription="@null" />
    </FrameLayout>

    <!-- Ranch name label, opposite side of the date plaque -->
    <TextView
        android:id="@+id/tvBrand"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/rye_regular"
        android:text="RANCH №7"
        android:textColor="@color/ww_saddle_dark"
        android:textSize="14sp"
        android:letterSpacing="0.08"
        android:alpha="0.75"
        android:textDirection="ltr"
        app:layout_constraintTop_toTopOf="@+id/tvDate"
        app:layout_constraintBottom_toBottomOf="@+id/tvDate"
        app:layout_constraintStart_toStartOf="parent"
        tools:ignore="HardcodedText" />

    <!-- Date shown as a tilted iron plaque with a shadow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvDate"
        android:fontFamily="@font/rye_regular"
        android:textColor="@color/ww_brass_light"
        android:background="@drawable/shape_ww_date_tag_bg"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:rotation="-3"
        android:elevation="8dp"
        android:layout_marginEnd="32dp"
        android:layout_marginTop="32dp"
        app:layout_constraintTop_toBottomOf="@+id/sceneBanner"
        app:layout_constraintEnd_toEndOf="parent"
        android:text="22/6"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvTakePicture"
        style="@style/Ww.Title"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@+id/tvDate"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/take_picture"
        />

    <!-- Camera button (elevation gives the shadow), vertically centered on the photo preview -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciTakePicture"
        android:layout_width="108dp"
        android:layout_height="108dp"
        android:elevation="8dp"
        android:src="@drawable/ic_camera_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/ivTakePicture"
        app:layout_constraintBottom_toBottomOf="@+id/ivTakePicture"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />
    <!-- Polaroid style photo preview; cropToPadding keeps the picture inside the frame border -->
    <ImageView
        android:id="@+id/ivTakePicture"
        android:layout_width="136dp"
        android:layout_height="132dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:padding="8dp"
        android:paddingBottom="24dp"
        android:background="@drawable/shape_ww_photo_frame"
        android:foreground="@drawable/ic_photo_pin"
        android:foregroundGravity="top|center_horizontal"
        android:src="@drawable/ic_photo_placeholder"
        android:scaleType="centerCrop"
        android:cropToPadding="true"
        android:rotation="-3"
        android:elevation="8dp"
        android:clipToOutline="true"
        android:contentDescription="@string/take_picture"
        app:layout_constraintTop_toBottomOf="@+id/tvTakePicture"
        app:layout_constraintStart_toEndOf="@+id/ciTakePicture"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvCowType"
        style="@style/Ww.Title"
        android:text="@string/cow_type"
        android:layout_marginTop="22dp"
        app:layout_constraintTop_toBottomOf="@+id/ivTakePicture"
        app:layout_constraintStart_toStartOf="parent"
        />

    <!-- Custom centered carousel to pick the cow type -->
    <com.israel.cowboyfriend.UI.widget.CowTypeCarouselView
        android:id="@+id/spNewCowType"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        app:layout_constraintTop_toBottomOf="@+id/tvCowType"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvNumberOfCalf"
        style="@style/Ww.Title"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/spNewCowType"
        app:layout_constraintStart_toStartOf="parent"
        android:text="@string/number_cow"
        />
    <!-- Hidden value holder of the cow number; the odometer below shows and edits it, voice input writes to this field -->
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etNumberOfCalf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <!-- 3-digit odometer for the cow number -->
    <com.israel.cowboyfriend.UI.widget.OdometerNumberView
        android:id="@+id/odoNumberOfCalf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:elevation="8dp"
        app:layout_constraintStart_toEndOf="@+id/ciNumberOfCalf"
        app:layout_constraintTop_toBottomOf="@+id/tvNumberOfCalf"
        />
    <!-- Voice button of the cow number -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciNumberOfCalf"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:elevation="8dp"
        android:src="@drawable/ic_mic_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/odoNumberOfCalf"
        app:layout_constraintBottom_toBottomOf="@+id/odoNumberOfCalf"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvGenderOfCalf"
        style="@style/Ww.Title"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/odoNumberOfCalf"
        app:layout_constraintStart_toStartOf="@+id/tvNumberOfCalf"
        android:text="@string/gender_cow"
        />
    <Spinner
        android:id="@+id/spGenderCalf"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:entries="@array/gender_options"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/ciGenderOfCalf"
        app:layout_constraintTop_toBottomOf="@+id/tvGenderOfCalf"
        android:background="@drawable/shape_ww_spinner_bg"
        android:spinnerMode="dropdown"
        tools:listitem="@layout/support_simple_spinner_dropdown_item"
        android:theme="@style/ww_spinnerTheme"
        android:popupBackground="@drawable/shape_ww_spinner_bg"
        />
    <!-- Voice button of the gender -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciGenderOfCalf"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:elevation="8dp"
        android:src="@drawable/ic_mic_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/spGenderCalf"
        app:layout_constraintBottom_toBottomOf="@+id/spGenderCalf"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />


    <!-- own row, below the mom number mic button + spinner -->
    <!-- Round checkbox (button tint removed so the star keeps its rust color) -->
    <androidx.appcompat.widget.AppCompatCheckBox
        android:id="@+id/cbWithMomNew"
        android:textColor="@color/ww_ink"
        android:fontFamily="@font/heebo_bold"
        android:text="@string/see_mother"
        android:textSize="18sp"
        android:paddingStart="8dp"
        android:layout_marginTop="10dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/checkbox_selector"
        app:buttonTint="@null"
        android:buttonTint="@null"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spMoms"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvNumberOfMom"
        style="@style/Ww.Title"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/spGenderCalf"
        app:layout_constraintStart_toStartOf="@+id/tvNumberOfCalf"
        android:text="@string/number_of_mom"
        />

    <!-- Anchors the comments block below whichever of the mom fields / calvings field is visible -->
    <androidx.constraintlayout.widget.Barrier
        android:id="@+id/barrierAfterMomOrCalvings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:barrierDirection="bottom"
        app:constraint_referenced_ids="cbWithMomNew,odoNumberOfCalvings"
        />

    <Spinner
        android:id="@+id/spMoms"
        android:layout_width="110dp"
        android:layout_height="48dp"
        android:entries="@array/cow_type"
        android:layout_marginBottom="25dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/shape_ww_spinner_bg"
        android:spinnerMode="dropdown"
        tools:listitem="@layout/support_simple_spinner_dropdown_item"
        android:theme="@style/ww_spinnerTheme"
        android:popupBackground="@drawable/shape_ww_spinner_bg"
        app:layout_constraintStart_toEndOf="@+id/ciNumberOfMom"
        app:layout_constraintTop_toBottomOf="@+id/tvNumberOfMom"
        />

    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etNumberOfMom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvNumberOfMom"
        android:ems="12"
        android:visibility="gone"
        android:inputType="numberDecimal"
        android:background="@drawable/shape_bottom_border"
        style="@style/edittext_style"
        />
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciNumberOfMom"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:elevation="8dp"
        android:src="@drawable/ic_mic_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/spMoms"
        app:layout_constraintBottom_toBottomOf="@+id/spMoms"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />

    <!-- number of calvings: shown instead of the mom fields for a cow / first-cow -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvNumberOfCalvings"
        style="@style/Ww.Title"
        android:visibility="gone"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/spGenderCalf"
        app:layout_constraintStart_toStartOf="@+id/tvNumberOfCalf"
        android:text="@string/number_of_calvings"
        />
    <!-- Hidden value holder of the number of calvings; the 2-digit odometer below shows and edits it -->
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etNumberOfCalvings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:inputType="numberDecimal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        />
    <!-- 2-digit odometer for the number of calvings (shown for a cow / first-cow only) -->
    <com.israel.cowboyfriend.UI.widget.OdometerNumberView
        android:id="@+id/odoNumberOfCalvings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:elevation="8dp"
        android:visibility="gone"
        app:digitCount="2"
        app:layout_constraintStart_toEndOf="@+id/ciNumberOfCalvings"
        app:layout_constraintTop_toBottomOf="@+id/tvNumberOfCalvings"
        />
    <!-- Voice button of the number of calvings -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciNumberOfCalvings"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@drawable/ic_mic_badge"
        android:visibility="gone"
        android:elevation="8dp"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/odoNumberOfCalvings"
        app:layout_constraintBottom_toBottomOf="@+id/odoNumberOfCalvings"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />

<!--    comments-->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/tvComments"
        style="@style/Ww.Title"
        android:layout_marginTop="26dp"
        app:layout_constraintTop_toBottomOf="@+id/barrierAfterMomOrCalvings"
        app:layout_constraintStart_toStartOf="@+id/tvNumberOfCalf"
        android:text="@string/comments"
        />
    <!-- Comments field with notebook style ruled lines, width follows the screen -->
    <androidx.appcompat.widget.AppCompatEditText
        android:id="@+id/etComments"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@+id/ciComments"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvComments"
        android:inputType="text|textMultiLine"
        android:background="@drawable/shape_ww_ledger_bg"
        style="@style/Ww.EditText"
        android:textSize="18sp"
        android:lineSpacingExtra="6dp"
        android:gravity="top"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:lines="3"
        android:minLines="3"
        android:scrollHorizontally="false"
        android:scrollbars="vertical"
        />

    <!-- Voice button of the comments -->
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciComments"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:elevation="8dp"
        android:src="@drawable/ic_mic_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toTopOf="@+id/etComments"
        app:layout_constraintBottom_toBottomOf="@+id/etComments"
        app:layout_constraintStart_toStartOf="parent"
        style="@style/button_style"
        />

    <!-- location values are kept in hidden holders; the status row below shows whether they were saved -->
    <!-- Hidden holder of the latitude (saved with the cow, not shown) -->
    <TextView
        android:id="@+id/tvLocationLatitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <!-- Hidden holder of the longitude (saved with the cow, not shown) -->
    <TextView
        android:id="@+id/tvLocationLongitude"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        />
    <!-- Save location button, the status icon and text next to it show whether the location was captured -->
    <Button
        android:id="@+id/btnSaveLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/save_location"
        android:textColor="@color/white"
        android:fontFamily="@font/heebo_bold"
        android:textSize="18sp"
        android:elevation="6dp"
        app:icon="@drawable/ic_pin_btn"
        app:iconTint="@null"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:backgroundTint="@color/ww_turquoise"
        app:strokeColor="@color/ww_iron"
        app:strokeWidth="2dp"
        app:layout_constraintTop_toBottomOf="@+id/etComments"
        app:layout_constraintStart_toStartOf="parent"
        />
    <!-- Location status icon (swapped between saved / not saved in code) -->
    <ImageView
        android:id="@+id/ivLocationStatus"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_location_unsaved"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="@+id/btnSaveLocation"
        app:layout_constraintBottom_toBottomOf="@+id/btnSaveLocation"
        app:layout_constraintStart_toEndOf="@+id/btnSaveLocation"
        />
    <!-- Location status text (swapped between saved / not saved in code) -->
    <TextView
        android:id="@+id/tvLocationStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:fontFamily="@font/heebo_bold"
        android:text="@string/location_not_saved"
        android:textColor="@color/ww_rust_dark"
        android:textSize="15sp"
        app:layout_constraintTop_toTopOf="@+id/btnSaveLocation"
        app:layout_constraintBottom_toBottomOf="@+id/btnSaveLocation"
        app:layout_constraintStart_toEndOf="@+id/ivLocationStatus"
        app:layout_constraintEnd_toEndOf="parent"
        />

    <!-- Round checkbox for the ear tag (calf only) -->
    <androidx.appcompat.widget.AppCompatCheckBox
        android:layout_marginStart="5dp"
        android:id="@+id/cbEarTag"
        android:textColor="@color/ww_ink"
        android:fontFamily="@font/heebo_bold"
        android:layout_gravity="end"
        android:text="@string/marked_tag"
        android:textSize="18sp"
        android:paddingStart="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:button="@drawable/checkbox_selector"
        app:buttonTint="@null"
        android:buttonTint="@null"
        android:layout_marginTop="26dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnSaveLocation"
        />

    <!-- Save button centered on the screen, clipChildren off so its shadow is not cut -->
    <FrameLayout
        android:id="@+id/frSave"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@+id/cbEarTag"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    <de.hdodenhof.circleimageview.CircleImageView
        android:id="@+id/ciSave"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        android:src="@drawable/ic_horseshoe_badge"
        app:civ_border_width="0dp"
        tools:ignore="MissingConstraints"
        app:layout_constraintTop_toBottomOf="@+id/tvNumberOfMom"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:elevation="12dp"
            android:textColor="@color/ww_saddle_dark"
            android:fontFamily="@font/heebo_bold"
            android:layout_gravity="bottom|center_horizontal"
            android:paddingBottom="14dp"
            android:textSize="18sp"
            android:text="@string/save"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>

    <!-- fixed (not scrolling) loading indicator shown while a cow is being saved -->
    <!-- Fixed full-screen loading overlay (does not scroll with the form), blocks touches while saving -->
    <FrameLayout
        android:id="@+id/loadingOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#990F0905"
        android:clickable="true"
        android:focusable="true"
        android:elevation="20dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/shape_ww_voice_card"
            android:elevation="12dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="40dp"
            android:paddingTop="30dp"
            android:paddingEnd="40dp"
            android:paddingBottom="26dp">

            <ImageView
                android:id="@+id/ivLoadingSpinner"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:contentDescription="@null"
                android:src="@drawable/avd_ww_loading" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="@font/heebo_bold"
                android:text="@string/saving_cow"
                android:textColor="@color/ww_ink"
                android:textSize="18sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- fixed result message shown after the save finished -->
    <!-- Fixed result message at the bottom, slides in after a save and hides itself -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="28dp"
        android:background="@drawable/shape_ww_result_banner"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/heebo_bold"
            android:textColor="@color/ww_parchment"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>

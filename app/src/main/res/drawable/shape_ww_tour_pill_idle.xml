<?xml version="1.0" encoding="utf-8"?>
<!-- The tour pill of the cattle tour screen when there is no tour: a brass pill with a dark border (only the flag is inside) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F0DC9A"
        android:centerColor="#C9A94E"
        android:endColor="#A88A36" />
    <corners android:radius="28dp" />
    <stroke
        android:width="3dp"
        android:color="@color/ww_iron" />
</shape>

<!-- Map pin of a living cow: brass drop with a dark border and a front view of a cow head (ears to the sides, short horns,
     a dark patch over one eye and a pink muzzle with nostrils); tap it to see the details of the cow -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="44dp"
    android:height="56dp"
    android:viewportWidth="44"
    android:viewportHeight="56">
    <path
        android:pathData="M22,54 C22,54 3,34 3,20 A19,19 0 1 1 41,20 C41,34 22,54 22,54 Z"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="3"
        android:strokeLineJoin="round">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="15"
                android:centerY="11"
                android:gradientRadius="36">
                <item android:offset="0.0" android:color="#F4E3A4" />
                <item android:offset="0.55" android:color="@color/ww_brass" />
                <item android:offset="1.0" android:color="#9C7E2E" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- the head is lifted by 2 so the narrow muzzle stays inside the round part of the pin -->
    <group android:translateY="-2">
        <!-- horns: short curved dark strokes on top of the head -->
        <path
            android:pathData="M17,11 C15.5,7.5 13,7 11.5,8.5 M27,11 C28.5,7.5 31,7 32.5,8.5"
            android:strokeColor="@color/ww_iron"
            android:strokeWidth="2.4"
            android:strokeLineCap="round"
            android:fillColor="#00000000"/>
        <!-- ears: leaf shapes sticking out to both sides, with a pink inside -->
        <path
            android:pathData="M15,15.5 C11.5,12.5 7.5,13.5 6.5,16.5 C8,19.5 12,20 15,19 Z M29,15.5 C32.5,12.5 36.5,13.5 37.5,16.5 C36,19.5 32,20 29,19 Z"
            android:fillColor="#F1E4C2"
            android:strokeColor="@color/ww_iron"
            android:strokeWidth="1.8"
            android:strokeLineJoin="round"/>
        <path
            android:pathData="M13.5,16.8 C11.5,15.5 9.5,16 9,17 C10,18 12,18.2 13.5,17.8 Z M30.5,16.8 C32.5,15.5 34.5,16 35,17 C34,18 32,18.2 30.5,17.8 Z"
            android:fillColor="#D98C84"/>
        <!-- head: wide forehead tapering to the muzzle -->
        <path
            android:pathData="M15.5,12 C15.5,10.5 18,9.5 22,9.5 C26,9.5 28.5,10.5 28.5,12 L29.5,20 C29.5,23.5 28,25.5 27.5,27.5 L27.5,31 C27.5,33.5 25,34.5 22,34.5 C19,34.5 16.5,33.5 16.5,31 L16.5,27.5 C16,25.5 14.5,23.5 14.5,20 Z"
            android:fillColor="#F1E4C2"
            android:strokeColor="@color/ww_iron"
            android:strokeWidth="2"
            android:strokeLineJoin="round"/>
        <!-- dark patch over one eye, like many cows have -->
        <path
            android:pathData="M23.5,11 C26.5,10.6 28.3,11.8 28.4,14.5 L28.8,19 C26.5,20.3 24,19.2 23.5,16.5 Z"
            android:fillColor="@color/ww_iron"/>
        <!-- eyes -->
        <path
            android:pathData="M18.2,19 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0 M25.8,19 m-1.5,0 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
            android:fillColor="@color/ww_iron"/>
        <path
            android:pathData="M18.7,18.5 m-0.5,0 a0.5,0.5 0 1,0 1,0 a0.5,0.5 0 1,0 -1,0"
            android:fillColor="#F1E4C2"/>
        <!-- pink muzzle with two nostrils -->
        <path
            android:pathData="M22,29.8 m-5.2,0 a5.2,3.9 0 1,0 10.4,0 a5.2,3.9 0 1,0 -10.4,0"
            android:fillColor="#E9A9A0"
            android:strokeColor="@color/ww_iron"
            android:strokeWidth="1.4"/>
        <path
            android:pathData="M19.8,29.8 m-0.95,0 a0.95,1.3 0 1,0 1.9,0 a0.95,1.3 0 1,0 -1.9,0 M24.2,29.8 m-0.95,0 a0.95,1.3 0 1,0 1.9,0 a0.95,1.3 0 1,0 -1.9,0"
            android:fillColor="@color/ww_iron"/>
    </group>
</vector>

<?xml version="1.0" encoding="utf-8"?>
<!-- Main button of the edit window (save): brass gradient rectangle with slightly rounded corners and a dark border -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F0DC9A"
        android:centerColor="#C9A94E"
        android:endColor="#A88A36" />
    <corners android:radius="10dp" />
    <stroke
        android:width="3dp"
        android:color="@color/ww_iron" />
</shape>

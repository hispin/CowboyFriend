<?xml version="1.0" encoding="utf-8"?>
<!-- Parchment background with dark border for text fields -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ww_parchment_2" />
    <corners android:radius="8dp" />
    <stroke
        android:width="2dp"
        android:color="@color/ww_iron" />
    <padding
        android:left="10dp"
        android:top="6dp"
        android:right="10dp"
        android:bottom="6dp" />
</shape>

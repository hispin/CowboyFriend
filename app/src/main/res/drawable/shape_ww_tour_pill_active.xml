<?xml version="1.0" encoding="utf-8"?>
<!-- The tour pill of the cattle tour screen while a tour is open: turquoise with a dark border (the progress is written inside) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ww_turquoise" />
    <corners android:radius="28dp" />
    <stroke
        android:width="3dp"
        android:color="@color/ww_iron" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- Login button: brass gradient pill with a dark border (same family as the save / voice badges) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#F0DC9A"
        android:centerColor="#C9A94E"
        android:endColor="#A88A36" />
    <corners android:radius="30dp" />
    <stroke
        android:width="3dp"
        android:color="@color/ww_iron" />
</shape>

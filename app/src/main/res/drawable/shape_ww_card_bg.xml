<?xml version="1.0" encoding="utf-8"?>
<!-- Cow card of the cattle tour list: parchment with a dark border and asymmetric corners (two big, two small) like a ticket / wanted poster -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/ww_parchment_2" />
    <corners
        android:topLeftRadius="22dp"
        android:topRightRadius="6dp"
        android:bottomLeftRadius="6dp"
        android:bottomRightRadius="22dp" />
    <stroke
        android:width="3dp"
        android:color="@color/ww_iron" />
</shape>

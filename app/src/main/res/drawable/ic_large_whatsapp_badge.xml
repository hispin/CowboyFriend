<!-- WhatsApp button of the large picture screen: a brass coin (gradient and gloss, dark border) with a dark speech bubble
     that holds a phone receiver -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="64"
    android:viewportHeight="64">
    <path android:pathData="M4.5,32 a27.5,27.5 0 1,0 55,0 a27.5,27.5 0 1,0 -55,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="23"
                android:centerY="19"
                android:gradientRadius="46">
                <item android:offset="0.0" android:color="#F4E3A4" />
                <item android:offset="0.5" android:color="@color/ww_brass" />
                <item android:offset="1.0" android:color="#9C7E2E" />
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M4.5,32 a27.5,27.5 0 1,0 55,0 a27.5,27.5 0 1,0 -55,0"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="3"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M11.5,26 A22,22 0 0 1 34,10.2"
        android:strokeColor="#99FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M15,47 A22,22 0 0 0 49,47"
        android:strokeColor="#40000000"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
    <!-- the speech bubble with a tail at the bottom start -->
    <path
        android:pathData="M32,16 C40.3,16 47,22.2 47,30 C47,37.8 40.3,44 32,44 C29.6,44 27.4,43.5 25.4,42.6 L18,45 L20.6,38.2 C18.4,36 17,33.2 17,30 C17,22.2 23.7,16 32,16 Z"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="3.2"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
    <!-- the phone receiver inside the bubble -->
    <path
        android:pathData="M25.5,24.5 C25.5,32 30.5,37 38,37.5"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="4.6"
        android:strokeLineCap="round"
        android:fillColor="#00000000"/>
</vector>

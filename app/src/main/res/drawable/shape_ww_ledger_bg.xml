            <solid android:color="@color/ww_saddle" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="62dp"
        android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/ww_saddle" />
        </shape>
    </item>
    <item
        android:left="10dp"
        android:right="10dp"
        android:top="89dp"
        android:height="1dp">

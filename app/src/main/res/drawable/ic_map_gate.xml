<!-- Map element "gate": a ranch gate (two posts, three rails and a diagonal brace, parchment color with a dark outline)
     on a wooden coin with a dark border. the coin is centered on the place that was long-pressed on the map -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="56dp"
    android:height="56dp"
    android:viewportWidth="100"
    android:viewportHeight="100">
    <!-- the wooden coin -->
    <path
        android:pathData="M5,50 a45,45 0 1,0 90,0 a45,45 0 1,0 -90,0"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="5">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="36"
                android:centerY="28"
                android:gradientRadius="78">
                <item android:offset="0.0" android:color="#B98550" />
                <item android:offset="0.55" android:color="@color/ww_saddle" />
                <item android:offset="1.0" android:color="@color/ww_saddle_dark" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- rails and brace: a dark outline first, then the parchment boards on top of it -->
    <path
        android:pathData="M29,36 H71 M29,50 H71 M29,64 H71 M29,64 L71,36"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="8.5"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M29,36 H71 M29,50 H71 M29,64 H71 M29,64 L71,36"
        android:strokeColor="@color/ww_parchment"
        android:strokeWidth="4.5"
        android:strokeLineCap="butt"
        android:fillColor="#00000000"/>
    <!-- the two posts -->
    <path
        android:pathData="M19,24 H30 V80 H19 Z M70,24 H81 V80 H70 Z"
        android:fillColor="@color/ww_parchment"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="3"
        android:strokeLineJoin="round"/>
</vector>

<!-- Animated vector: the horseshoe of ic_loading_horseshoe rotates forever (runs on the render thread, so it keeps spinning while the main thread is busy saving) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_loading_horseshoe">
    <target android:name="spin">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="rotation"
                android:duration="1200"
                android:valueFrom="0"
                android:valueTo="360"
                android:repeatCount="-1"
                android:interpolator="@android:interpolator/linear" />
        </aapt:attr>
    </target>
</animated-vector>

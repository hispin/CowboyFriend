    android:viewportHeight="44">
    <path
        android:pathData="M3,22 a19,19 0 1,0 38,0 a19,19 0 1,0 -38,0"
        android:strokeColor="@color/ww_iron"
        android:strokeWidth="2.6">
        <aapt:attr name="android:fillColor">
            <gradient

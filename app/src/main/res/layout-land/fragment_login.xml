<?xml version="1.0" encoding="utf-8"?>
<!-- Login screen in landscape: two panels side by side instead of one tall column - the desert banner with the horseshoe coin,
     the ranch name and "Welcome" on one side, and the card with the fields and the login button on the other.
     the ids are the same as in the portrait layout, so the code is shared -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment">

    <!-- scrolls when the keyboard is open (the screen is short) -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="12dp"
            android:weightSum="10">

            <!-- the welcome panel: banner with the coin on its bottom edge, the ranch name and "Welcome" -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="4"
                android:clipChildren="false"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:background="@drawable/shape_ww_banner_sky">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:scaleType="fitXY"
                            android:src="@drawable/ic_scene_banner" />
                    </FrameLayout>

                    <ImageView
                        android:layout_width="76dp"
                        android:layout_height="76dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="-28dp"
                        android:contentDescription="@null"
                        android:elevation="10dp"
                        android:src="@drawable/ic_horseshoe_badge" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvFarmName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:alpha="0.75"
                    android:fontFamily="@font/rye_regular"
                    android:gravity="center"
                    android:letterSpacing="0.08"
                    android:text="RANCH №7"
                    android:textColor="@color/ww_saddle_dark"
                    android:textDirection="ltr"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/heebo_extrabold"
                    android:gravity="center"
                    android:text="@string/welcome"
                    android:textColor="@color/ww_ink"
                    android:textSize="28sp" />
            </LinearLayout>

            <!-- the form panel: card with the fields, then the login button -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="24dp"
                android:layout_weight="6"
                android:clipChildren="false"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_ww_voice_card"
                    android:elevation="6dp"
                    android:orientation="vertical"
                    android:paddingStart="22dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="18dp">

                    <TextView
                        android:id="@+id/tvUser"
                        style="@style/Ww.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/user" />

                    <androidx.appcompat.widget.AppCompatEditText
                        android:id="@+id/etUsername"
                        android:imeOptions="flagNoExtractUi"
                        style="@style/Ww.EditText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/shape_ww_edittext_bg"
                        android:inputType="textEmailAddress"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textDirection="ltr"
                        android:textSize="17sp" />

                    <TextView
                        android:id="@+id/tvUserError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/heebo_bold"
                        android:textColor="@color/ww_rust_dark"
                        android:textSize="14sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/tvPassword"
                        style="@style/Ww.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/password" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp">

                        <androidx.appcompat.widget.AppCompatEditText
                            android:id="@+id/etPassword"
                            android:imeOptions="flagNoExtractUi"
                            style="@style/Ww.EditText"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@drawable/shape_ww_edittext_bg"
                            android:inputType="textPassword"
                            android:paddingStart="14dp"
                            android:paddingEnd="56dp"
                            android:singleLine="true"
                            android:textDirection="ltr"
                            android:textSize="17sp" />

                        <ImageView
                            android:id="@+id/ivTogglePassword"
                            android:layout_width="48dp"
                            android:layout_height="52dp"
                            android:layout_gravity="end|center_vertical"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:contentDescription="@string/show_password"
                            android:focusable="true"
                            android:padding="10dp"
                            android:src="@drawable/ic_eye_closed" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tvPasswordError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/heebo_bold"
                        android:textColor="@color/ww_rust_dark"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:clipChildren="false">

                    <ImageView
                        android:id="@+id/ivLogin"
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:background="@drawable/shape_ww_login_btn"
                        android:clickable="true"
                        android:contentDescription="@string/connect"
                        android:elevation="8dp"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tvConnection"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:layout_gravity="center"
                        android:elevation="10dp"
                        android:fontFamily="@font/heebo_extrabold"
                        android:gravity="center"
                        android:text="@string/connect"
                        android:textColor="@color/ww_iron"
                        android:textSize="21sp" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- loading while logging in: the spinning horseshoe, centered and above everything -->
    <ProgressBar
        android:id="@+id/pbLogin"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:elevation="20dp"
        android:indeterminate="true"
        android:indeterminateDrawable="@drawable/avd_ww_loading"
        android:visibility="gone" />

    <!-- fixed result message at the bottom: login success / failure -->
    <LinearLayout
        android:id="@+id/resultBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/shape_ww_result_banner"
        android:elevation="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivResultIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/tvResultText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/heebo_bold"
            android:textColor="@color/ww_parchment"
            android:textSize="17sp" />
    </LinearLayout>
</FrameLayout>

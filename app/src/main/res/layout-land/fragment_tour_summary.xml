<?xml version="1.0" encoding="utf-8"?>
<!-- Tour summary screen in landscape: a thin header, and two columns side by side in the scrolling body (the coverage and
     the number tiles on one side, what needs attention on the other); the buttons are in the header row.
     the ids are the same as in the portrait layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ww_saddle_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tour_flag"
            android:tint="@color/ww_brass_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heebo_extrabold"
                android:text="@string/summary_title"
                android:textColor="@color/ww_parchment"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSummarySubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heebo_medium"
                android:textColor="@color/ww_brass_light"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnSummaryShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_ww_btn_rect_brass"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="7dp"
            android:paddingEnd="20dp"
            android:paddingBottom="7dp"
            android:text="@string/summary_share"
            android:textColor="@color/ww_iron"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/btnSummaryClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:paddingStart="20dp"
            android:paddingTop="7dp"
            android:paddingEnd="20dp"
            android:paddingBottom="7dp"
            android:text="@string/close"
            android:textColor="@color/ww_ink"
            android:textSize="16sp" />

        <ImageButton
            android:id="@+id/ibSummaryClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/shape_ww_photo_ring"
            android:contentDescription="@string/close"
            android:elevation="6dp"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_large_close_badge" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/view_summary_coverage" />

                <include
                    layout="@layout/view_summary_tiles"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/view_summary_attention" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

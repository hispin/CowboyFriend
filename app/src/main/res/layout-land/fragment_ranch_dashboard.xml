<?xml version="1.0" encoding="utf-8"?>
<!-- Ranch dashboard in landscape: a thin header with the share buttons, and two columns of cards side by side (the herd,
     what needs attention and the heat map on one side; health, births and deaths and the trend on the other).
     the ids are the same as in the portrait layout -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ww_parchment"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ww_saddle_dark"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_tour_flag"
            android:tint="@color/ww_brass_light" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/heebo_extrabold"
            android:text="@string/dash_title"
            android:textColor="@color/ww_parchment"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btnDashShareText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_ww_btn_rect_brass"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_extrabold"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="@string/dash_share_text"
            android:textColor="@color/ww_iron"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/btnDashSharePdf"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/shape_ww_btn_rect_sand"
            android:elevation="4dp"
            android:fontFamily="@font/heebo_bold"
            android:gravity="center"
            android:paddingStart="18dp"
            android:paddingTop="7dp"
            android:paddingEnd="18dp"
            android:paddingBottom="7dp"
            android:text="@string/dash_share_pdf"
            android:textColor="@color/ww_ink"
            android:textSize="15sp" />

        <ImageButton
            android:id="@+id/ibDashClose"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/shape_ww_photo_ring"
            android:contentDescription="@string/close"
            android:elevation="6dp"
            android:padding="0dp"
            android:scaleType="fitXY"
            android:src="@drawable/ic_large_close_badge" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fadeScrollbars="false"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:id="@+id/llDashContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/ww_parchment"
            android:baselineAligned="false"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/view_dash_herd" />

                <include
                    layout="@layout/view_dash_attention"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    layout="@layout/view_dash_map"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <include layout="@layout/view_dash_health" />

                <include
                    layout="@layout/view_dash_years"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <include
                    layout="@layout/view_dash_trend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

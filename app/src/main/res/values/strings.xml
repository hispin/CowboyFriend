    <!-- Comment dictation: how to finish, and the small guide window -->
    <string name="voice_dictation_hint">Say “end” to finish</string>
    <string name="dictation_guide_title">How to dictate a comment</string>
    <string name="dictation_guide_text">1. Tap the microphone and start talking.\n2. You can pause and continue, everything is added to the comment.\n3. To finish, say “end” as the last word of your last sentence.\n4. The text appears in the comment field, you can fix it and then tap Save.\n5. Cancel closes without adding what was said.</string>
    <string name="dictation_guide_button">Dictation guide</string>
    <string name="search_guide_title">How to search cows by voice</string>
    <string name="search_guide_text">1. Tap the microphone and say a cow number.\n2. To search by year of birth, say the last two digits of the year after the number. For example: “2” ... “26” shows cow 2 born in 2026.\n3. A number without a year shows every cow with that number, in any year.\n4. Several cows: say “comma” between the cows. For example: “2, 26, comma, 7, comma, 15, 24”.\n5. To finish, say “end”. Listening does not stop before that, you can pause.\n6. Cancel closes without searching.</string>

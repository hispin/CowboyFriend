<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CowboyFriend" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="title">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="button_style">
        <item name="android:layout_marginStart">5dp</item>
    </style>

    <style name="edittext_style">
        <item name="android:layout_marginStart">5dp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="spinnerTheme">
        <item name="android:textColor">@color/black</item>
    </style>

    <!-- Wild West theme styles, scoped to the New Calf screen only -->
    <style name="Ww.Title" parent="">
        <item name="android:fontFamily">@font/heebo_bold</item>
        <item name="android:textColor">@color/ww_ink</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Ww.EditText" parent="">
        <item name="android:fontFamily">@font/heebo_medium</item>
        <item name="android:textColor">@color/ww_ink</item>
        <item name="android:textColorHint">@color/ww_ink_soft</item>
    </style>

    <style name="Ww.NumberField" parent="">
        <item name="android:fontFamily">@font/rye_regular</item>
        <item name="android:textColor">@color/ww_brass_light</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Ww.SpinnerText" parent="">
        <item name="android:fontFamily">@font/heebo_bold</item>
        <item name="android:textColor">@color/ww_ink</item>
    </style>

    <style name="ww_spinnerTheme">
        <item name="android:textColor">@color/ww_ink</item>
    </style>

    <style name="Ww.CarouselSide" parent="">
        <item name="android:fontFamily">@font/frank_ruhl_medium</item>
        <item name="android:textColor">@color/ww_parchment_2</item>
        <item name="android:textSize">13sp</item>
        <item name="android:alpha">0.7</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Ww.CarouselCenter" parent="">
        <item name="android:fontFamily">@font/frank_ruhl_bold</item>
        <item name="android:textColor">@color/ww_iron</item>
        <item name="android:textSize">18sp</item>
        <item name="android:background">@drawable/shape_ww_pill_bg</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:singleLine">true</item>
    </style>

    <!-- text appearance of the top tabs -->
    <style name="Ww.TabText" parent="TextAppearance.Design.Tab">
        <item name="android:fontFamily">@font/heebo_bold</item>
        <item name="android:textSize">16sp</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="Theme.CowboyFriend" parent="Base.Theme.CowboyFriend" />
</resources>